{
  "name": "bugfix-casebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Five common web-app bugs, each with the broken code, the fix, a test that proves it, and a plain-language fix note.",
  "scripts": {
    "test": "vitest run",
    "test:before": "cross-env VARIANT=before vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
